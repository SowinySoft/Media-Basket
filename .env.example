# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/media_basket
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/media_basket

# ── Redis (optional, for WebSocket fan-out + rate limiting) ──────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── App ──────────────────────────────────────────────────────────────
APP_NAME=Media Basket
APP_VERSION=0.1.0
DEBUG=true

# ── YouTube ──────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/services/callback/youtube

# ── Reddit ───────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:8000/api/v1/services/callback/reddit

# ── WhatsApp Business API ────────────────────────────────────────────
